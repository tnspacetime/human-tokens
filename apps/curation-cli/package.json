{
  "name": "@human-tokens/curation-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive command shell for Human Tokens curation workflows",
  "bin": {
    "human-tokens": "./dist/bin.js",
    "ht": "./dist/bin.js"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "bun build ./src/bin.ts --target=node --outdir=dist",
    "start": "node dist/bin.js",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "open": "^11.0.1",
    "shell-quote": "^1.10.0",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
